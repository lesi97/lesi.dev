      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Destiny Avg Playercount",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afem93txittdsf"
                      },
                      "spec": {
                        "dataset": "postgres",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "with parsed as (\r\n  select\r\n    event_timestamp,\r\n    nullif(\r\n      regexp_replace(\r\n        (regexp_match(response, 'currently\\s+([0-9,]+)\\s+players'))[1],\r\n        ',',\r\n        '',\r\n        'g'\r\n      ),\r\n      ''\r\n    )::bigint as steam_players,\r\n    nullif(\r\n      regexp_replace(\r\n        (regexp_match(response, '&\\s*([0-9,]+)\\s+players\\s+in\\s+Trials'))[1],\r\n        ',',\r\n        '',\r\n        'g'\r\n      ),\r\n      ''\r\n    )::bigint as trials_players\r\n  from logs.api\r\n  where $__timeFilter(event_timestamp)\r\n    and route = '/v1/d2/trials/playercount'\r\n    and status_code = 200\r\n),\r\nbucketed as (\r\n  select\r\n    case\r\n      when extract(epoch from ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) <= 172800\r\n        then date_trunc('hour', event_timestamp)\r\n      else date_trunc('day', event_timestamp)\r\n    end as bucket_time,\r\n    steam_players,\r\n    coalesce(trials_players, 0) as trials_players\r\n  from parsed\r\n)\r\nselect\r\n  bucket_time as \"time\",\r\n  avg(steam_players)::double precision as steam_players_avg,\r\n  avg(trials_players)::double precision as trials_players_avg\r\nfrom bucketed\r\nwhere steam_players is not null\r\ngroup by 1\r\norder by 1\r\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
