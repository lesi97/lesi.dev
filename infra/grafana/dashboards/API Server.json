                        "rawSql": "select\r\n  user_name,\r\n  channel,\r\n  coalesce(\r\n    nullif(substring(route from '(?:\\?|&)command=([^&]+)'), ''),\r\n    route\r\n  ) as command,\r\n  count(*) as call_count\r\nfrom (\r\n  select\r\n    user_name,\r\n    channel,\r\n    regexp_replace(\r\n      regexp_replace(route, '([?&])nonce=\\d+(&)?', '\\1', 'g'),\r\n      '[?&]$',\r\n      '',\r\n      'g'\r\n    ) as route\r\n  from logs.api\r\n  where $__timeFilter(event_timestamp)\r\n    and bot_type is not null\r\n) t\r\ngroup by\r\n  user_name,\r\n  channel,\r\n  command\r\norder by call_count desc\r\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
