                        "rawQuery": true,
                        "rawSql": "select\r\n  user_name,\r\n  substring(route from '(?:\\?|&)command=([^&]+)') as command,\r\n  count(*) as amount_used\r\nfrom (\r\n  select\r\n    user_name,\r\n    regexp_replace(\r\n      regexp_replace(route, '([?&])nonce=\\d+(&)?', '\\1', 'g'),\r\n      '[?&]$',\r\n      '',\r\n      'g'\r\n    ) as route\r\n  from logs.api\r\n  where $__timeFilter(event_timestamp)\r\n    and bot_type is not null\r\n    and channel = 'terror'\r\n) t\r\nwhere substring(route from '(?:\\?|&)command=([^&]+)') is not null\r\ngroup by\r\n  user_name,\r\n  command\r\norder by amount_used desc, user_name asc\r\n",
