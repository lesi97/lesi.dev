                      "spec": {
                        "dataset": "postgres",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select\r\n  event_timestamp,\r\n  user_name,\r\n  coalesce(\r\n    nullif(substring(route from '(?:\\?|&)command=([^&]+)'), ''),\r\n    route\r\n  ) as command,\r\n  response\r\nfrom (\r\n  select\r\n    event_timestamp,\r\n    user_name,\r\n    regexp_replace(\r\n      regexp_replace(route, '([?&])nonce=\\d+(&)?', '\\1', 'g'),\r\n      '[?&]$',\r\n      '',\r\n      'g'\r\n    ) as route,\r\n    response\r\n  from logs.api\r\n  where $__timeFilter(event_timestamp)\r\n    and bot_type is not null\r\n    and channel = 'terror'\r\n    and status_code != 404\r\n    and event_timestamp > '2026-02-16 15:11:05'\r\n) t\r\ngroup by\r\n  event_timestamp,\r\n  user_name,\r\n  command,\r\n  response\r\norder by event_timestamp desc",
