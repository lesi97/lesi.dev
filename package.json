{
    "name": "lesi.dev-go-api",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "dev": "npm run dev:web",
        "dev:web": "npm run -w apps/web dev",
        "dev:api": "npm run -w apps/api dev",
        "dev:api-with-redis": "concurrently --kill-others \"npm run redis\" \"npm run dev:api\" ",
        "redis": "docker compose -f infra/templates/compose-redis.dev.yml up redis",
        "redis:down": "docker compose -f infra/templates/compose-redis.dev.yml down",
        "redis:reset": "docker compose -f infra/templates/compose-redis.dev.yml down -v",
        "dev:all": "concurrently --kill-others \"npm run dev:redis\" \"npm run dev:api\" \"npm run dev:web\"",
        "build": "npm run -w apps/web build",
        "typecheck": "npm run -w apps/web typecheck",
        "docker:build": "docker build -t lesi.dev .",
        "docker:run": "docker run --rm -p 8080:8080 lesi.dev",
        "package-lock:regen": "docker run --rm -v \"%cd%:/repo\" -w /repo node:22-bookworm-slim bash -lc \"npm install\"",
        "prepare": "husky",
        "deploy": "pwsh -File ./scripts/publish-api.ps1"
    },
    "workspaces": [
        "apps/api",
        "apps/web"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lesi97/lesi.dev.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/lesi97/lesi.dev/issues"
    },
    "homepage": "https://github.com/lesi97/lesi.dev#readme",
    "devDependencies": {
        "concurrently": "^9.2.1",
        "husky": "^9.1.7"
    }
}
